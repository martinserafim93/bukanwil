# ----------------------------------------------------------------------
# Security Hardening for Uploads Directory
# Disables direct script execution and limits access to media files
# ----------------------------------------------------------------------

# Disable directory browsing
Options -Indexes -ExecCGI

# Turn off PHP execution in mod_php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block all script extensions and executable types
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd|html|htm|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow safe image and media files to be served
<FilesMatch "(?i)\.(jpe?g|png|webp|gif|svg|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>
